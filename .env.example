# Copy to .env and fill in your own values. These are not sample credentials
# for a bundled dev database — docker-compose.yml does not run Postgres/Redis
# for local development, only for tests (postgres-test/redis-test, "test" profile).
# Point these at your own local or managed Postgres/Redis instance.

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/webhook_relay
REDIS_URL=redis://host:6379/0

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Optional overrides (defaults shown; see src/webhook_relay/config.py)
# APP_NAME=Webhook Relay
# DEBUG=true
# ENV=local          # local | production — production requires TLS to Postgres
# HTTP_CONNECT_TIMEOUT=5.0
# HTTP_READ_TIMEOUT=10.0
# RETRY_MAX_ATTEMPTS=5
# RETRY_BASE_DELAY=1.0
# RETRY_MAX_DELAY=300.0
# RETRY_JITTER=1.0
